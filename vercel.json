{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/mobil/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!build|images|E-BROSUR MOBIL|favicon.ico|robots.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-inertia",
          "value": "true"
        }
      ]
    }
  ]
}
{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/build/(.*)",
      "destination": "/build/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/images/$1"
    },
    {
      "source": "/((?!images|build|sitemap.xml|robots.txt|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}